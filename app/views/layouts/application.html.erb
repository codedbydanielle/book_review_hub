<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Book Review Hub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="margin:0; background-color:#fdf8f6; font-family:Georgia,'Times New Roman',serif; color:#4a1c35;">

    <!-- TOP ACCENT -->
    <div style="height:10px; background:linear-gradient(90deg,#6d28d9,#c2547a,#f4b6cc);"></div>

    <!-- NAVBAR -->
    <nav style="background:rgba(255,255,255,0.82); backdrop-filter:blur(12px); border-bottom:1px solid #f0d6df; position:sticky; top:0; z-index:100;">
      <div style="max-width:1400px; margin:0 auto; padding:24px 34px; display:flex; align-items:center; justify-content:space-between; gap:20px;">

        <!-- LOGO -->
        <%= link_to root_path,
          style:"display:flex; align-items:center; gap:14px; text-decoration:none;" do %>

          <div style="font-size:2rem;">
            📖
          </div>

          <div>
            <div style="font-size:3rem; font-weight:700; color:#5a2340; line-height:1;">
              Book Review Hub
            </div>

            <div style="font-size:0.85rem; color:#c48aa2; margin-top:4px;">
              Cozy Reads & Honest Reviews
            </div>
          </div>

        <% end %>

        <!-- NAV LINKS -->
        <div style="display:flex; align-items:center; gap:40px;">

          <%= link_to books_path,
            style:"text-decoration:none; color:#c2547a; font-weight:700; font-size:1.15rem; position:relative;" do %>
            📖 Browse Books
          <% end %>

          <% if user_signed_in? %>

            <%= link_to my_books_path,
              style:"text-decoration:none; color:#7d3554; font-weight:700; font-size:1.1rem;" do %>
              ♡ My Books
            <% end %>

            <%= link_to my_reviews_path,
              style:"text-decoration:none; color:#7d3554; font-weight:700; font-size:1.1rem;" do %>
              💭 My Reviews
            <% end %>

          <% end %>

        </div>

        <!-- USER SECTION -->
         <div style="display:flex; align-items:center; gap:22px;">
          <% if user_signed_in? %>
            <div style="display:flex; align-items:center; gap:18px;">
              <div style="width:52px; height:52px; border-radius:999px; background:linear-gradient(135deg,#f7cad8,#e7a8bc); display:flex; align-items:center; justify-content:center; font-weight:700; color:#7d3554; font-size:1.2rem; box-shadow:0 4px 10px rgba(194,84,122,0.2); flex-shrink:0;">
                <%= current_user.username.first.upcase %>
              </div>

              <div style="display:flex; flex-direction:column; line-height:1.1;">
                <div style="font-size:1.05rem; color:#5a2340; font-weight:700; white-space:nowrap;">
                  <%= current_user.username %>
                </div>
                <div style="font-size:0.78rem; color:#c48aa2; margin-top:2px;">
                  Reader Profile
                </div>
              </div>
            </div>

            <%= button_to "Log out",
              destroy_user_session_path,
              method: :delete,
              style:"background:white; border:2px solid #e7a8bc; color:#7d3554; border-radius:999px; padding:12px 24px; font-size:0.95rem; font-family:Georgia,serif; cursor:pointer; font-weight:700;" %>
          <% else %>
            <%= link_to "Log in", new_user_session_path,
              style:"text-decoration:none; color:#7d3554; font-weight:700; font-size:1rem;" %>

            <%= link_to "Create Account", new_user_registration_path,
              style:"background:linear-gradient(135deg,#c2547a,#e08fad); color:white; text-decoration:none; padding:14px 26px; border-radius:999px; font-weight:700; box-shadow:0 8px 18px rgba(194,84,122,0.2);" %>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- MAIN -->
    <main style="max-width:1500px; margin:0 auto; padding:40px 28px;">

      <% if notice %>
        <div style="background:#fff0f5; border:1px solid #f4c7d5; color:#9b4b67; padding:18px 22px; border-radius:18px; margin-bottom:28px; display:flex; align-items:center; justify-content:space-between; box-shadow:0 6px 18px rgba(0,0,0,0.03);">
          <div style="display:flex; align-items:center; gap:12px;">
            <span style="font-size:1.2rem;">✓</span>
            <span style="font-weight:600;"><%= notice %></span>
          </div>
        </div>
      <% end %>

      <% if alert %>
        <div style="background:#fff1f2; border:1px solid #fecdd3; color:#be123c; padding:18px 22px; border-radius:18px; margin-bottom:28px;">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>

    </main>

    <!-- FOOTER -->
    <footer style="margin-top:80px; border-top:1px solid #f0d6df; background:#fffafb;">
      <div style="max-width:1400px; margin:0 auto; padding:34px 28px; text-align:center;">

        <div style="font-size:1.5rem; margin-bottom:10px;">
          📚 ✨ ☕
        </div>

        <p style="margin:0; color:#b07090; font-size:0.95rem;">
          Book Review Hub — your cozy little corner for books, reviews, and late-night reading thoughts.
        </p>

      </div>
    </footer>

  </body>
</html>