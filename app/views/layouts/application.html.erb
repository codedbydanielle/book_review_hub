<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Book Review Hub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="margin:0; background:#fdf6f0; font-family: Georgia, 'Times New Roman', serif; color:#4a1c35;">
    <nav style="height:88px; background:#fff7f8; border-bottom:1px solid #f0c4d0; display:flex; align-items:center; justify-content:space-between; padding:0 36px;">
      <%= link_to root_path, style:"font-size:1.7rem; font-weight:700; color:#7d3554; text-decoration:none;" do %>
        📖 Book Review Hub
      <% end %>

      <div style="display:flex; align-items:center; gap:56px; font-weight:700;">
        <%= link_to "📖 Browse Books", books_path, style:"color:#c2547a; text-decoration:none; border-bottom:3px solid #c2547a; padding:34px 20px 30px;" %>
        <span style="color:#7d3554;">♡ My Books</span>
        <span style="color:#7d3554;">♡ My Reviews</span>
      </div>

      <div style="display:flex; align-items:center; gap:18px;">
        <% if user_signed_in? %>
          <div style="width:44px; height:44px; border-radius:50%; background:#f8c8d8; display:flex; align-items:center; justify-content:center; font-weight:700; color:#7d3554;">
            <%= current_user.email.first.upcase %>
          </div>

          <span style="color:#7d3554; font-size:0.95rem;">
            <%= current_user.email %>
          </span>

          <%= button_to "Log out", destroy_user_session_path, method: :delete,
            style:"border:1.5px solid #d4849e; background:white; color:#7d3554; border-radius:999px; padding:11px 26px; font-family:Georgia,serif; font-weight:700; cursor:pointer;" %>
        <% else %>
          <%= link_to "Log in", new_user_session_path, style:"color:#7d3554; font-weight:700; text-decoration:none;" %>
          <%= link_to "Sign up", new_user_registration_path, style:"background:#c2547a; color:white; border-radius:999px; padding:11px 24px; text-decoration:none; font-weight:700;" %>
        <% end %>
      </div>
    </nav>

    <main style="padding:24px 36px 60px;">
      <% if notice %>
        <p style="background:#fff0f5; border:1px solid #f0b8cc; border-radius:10px; padding:16px 20px; color:#7d3554;">
          ✓ <%= notice %>
        </p>
      <% end %>

      <% if alert %>
        <p style="background:#fdecea; border:1px solid #f5b7b7; border-radius:10px; padding:16px 20px; color:#9b2c2c;">
          <%= alert %>
        </p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>