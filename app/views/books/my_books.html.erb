<% content_for :title, "My Books" %>

<div>
  <h1 style="font-size:3rem; color:#4a1c35; margin-bottom:10px;">
    My Books
  </h1>

  <p style="color:#b07090; margin-bottom:32px;">
    Books you've added to your library 📚
  </p>

  <% if @books.any? %>

    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:28px;">

      <% @books.each do |book| %>

        <div style="background:white; border:1px solid #f0c4d0; border-radius:24px; overflow:hidden; box-shadow:0 10px 20px rgba(0,0,0,0.04);">

          <div style="background:linear-gradient(135deg,#fff0f3,#fde7ef); height:220px; display:flex; align-items:center; justify-content:center;">
            <div style="width:120px; height:170px; background:white; border-radius:14px; display:flex; align-items:center; justify-content:center; font-size:3rem; box-shadow:0 8px 18px rgba(0,0,0,0.08);">
              📖
            </div>
          </div>

          <div style="padding:24px;">

            <span style="background:#fce8ef; color:#c2547a; font-size:0.75rem; font-weight:700; padding:5px 12px; border-radius:999px;">
              <%= book.genre %>
            </span>

            <h2 style="font-size:2rem; color:#4a1c35; margin:16px 0 6px;">
              <%= book.title %>
            </h2>

            <p style="color:#b07090;">
              by <%= book.author %>
            </p>

            <div style="margin-top:24px; display:flex; gap:12px; align-items:center;">

              <%= link_to "View Book →", book,
                style:"background:#fce8ef; color:#7d3554; border-radius:999px; padding:10px 18px; text-decoration:none; font-weight:700;" %>

              <%= link_to "Edit", edit_book_path(book),
                style:"color:#b07090;" %>

            </div>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <div style="background:white; border:1px solid #f0c4d0; border-radius:24px; padding:60px; text-align:center;">

      <p style="font-size:4rem;">📚</p>

      <h2 style="color:#4a1c35;">
        No books added yet
      </h2>

      <p style="color:#b07090;">
        Start building your cozy reading collection.
      </p>

      <%= link_to "+ Add a Book", new_book_path,
        style:"display:inline-block; margin-top:18px; background:#c2547a; color:white; padding:12px 24px; border-radius:999px; text-decoration:none; font-weight:700;" %>

    </div>

  <% end %>
</div>