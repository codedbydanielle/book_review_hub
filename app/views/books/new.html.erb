<% content_for :title, "Add a Book" %>

<div style="max-width: 600px; margin: 0 auto;">
  <h1 style="font-size: 2rem; font-weight: 700; color: #4a1c35; margin-bottom: 0.25rem;">
    Add a Book
  </h1>

  <p style="color: #b07090; margin-bottom: 2rem; font-size: 0.95rem;">
    Share a book with the community
  </p>

  <div style="background: white; border: 1px solid #f0c4d0; border-radius: 20px; padding: 2rem;">
    <%= render "form", book: @book %>
  </div>

  <div style="margin-top: 1.5rem;">
    <%= link_to "← Back to Books",
      books_path,
      style: "color: #c2547a; font-weight: 600; text-decoration: none; font-size: 0.9rem;" %>
  </div>
</div>