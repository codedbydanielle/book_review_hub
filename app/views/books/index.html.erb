<% content_for :title, "Books" %>

<div>
  <h1 style="font-size:3rem; margin:35px 0 8px; color:#4a1c35;">
    All Books
  </h1>

  <p style="color:#b07090; font-size:1.1rem; margin-bottom:24px;">
    Discover your next great read ✨
  </p>

  <% if user_signed_in? %>
    <%= link_to "+ Add a Book", new_book_path,
      style:"display:inline-block; background:#c2547a; color:white; border-radius:999px; padding:12px 30px; font-weight:700; text-decoration:none; box-shadow:0 6px 14px rgba(194,84,122,0.25); margin-bottom:28px;" %>
  <% end %>

  <% if @books.any? %>
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(330px, 330px)); gap:32px;">
      <% @books.each do |book| %>
        <% average_rating = book.reviews.any? ? book.reviews.average(:rating).to_f.round(1) : 0 %>

        <div style="background:white; border:1px solid #f0c4d0; border-radius:22px; overflow:hidden; box-shadow:0 10px 22px rgba(0,0,0,0.04);">
          <div style="height:220px; background:linear-gradient(135deg,#fff0f3,#fde7ef); display:flex; align-items:center; justify-content:center; border-bottom:1px solid #f0c4d0;">
            <% if book.cover_image.attached? %>
              <%= image_tag book.cover_image,
                style:"width:120px; height:170px; object-fit:cover; border-radius:10px; box-shadow:0 8px 18px rgba(0,0,0,0.08);" %>
            <% else %>
              <div style="width:120px; height:170px; background:white; border-radius:10px; display:flex; align-items:center; justify-content:center; box-shadow:0 8px 18px rgba(0,0,0,0.08); font-size:2.2rem;">
                📖
              </div>
            <% end %>
          </div>

          <div style="padding:26px;">
            <% if book.genre.present? %>
              <span style="background:#fce8ef; color:#c2547a; font-size:0.75rem; font-weight:700; padding:4px 13px; border-radius:999px;">
                <%= book.genre.upcase %>
              </span>
            <% end %>

            <h2 style="font-size:1.45rem; line-height:1.2; margin:16px 0 10px; color:#4a1c35;">
              <%= book.title %>
            </h2>

            <p style="color:#b07090; margin-bottom:16px;">
              by <%= book.author %>
            </p>

            <p style="color:#e7a8bc; font-size:1rem; font-weight:700;">
              <% 5.times do |i| %>
                <%= i < average_rating.round ? "★" : "☆" %>
              <% end %>
              <span style="color:#7d3554; margin-left:8px;">
                <%= average_rating %>/5
              </span>
            </p>

            <% if book.description.present? %>
              <p style="color:#6b4c5a; line-height:1.6; font-size:0.92rem;">
                <%= truncate(book.description, length: 90) %>
              </p>
            <% end %>

            <div style="margin-top:24px; display:flex; align-items:center; gap:14px;">
              <%= link_to "View Book →", book,
                style:"background:#fce8ef; color:#7d3554; border-radius:999px; padding:9px 18px; font-weight:700; text-decoration:none;" %>

              <% if user_signed_in? && book.user == current_user %>
                <%= link_to "Edit", edit_book_path(book),
                  style:"color:#b07090; font-size:0.9rem;" %>

                <%= button_to "Delete", book,
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" },
                  style:"background:transparent; border:none; color:#c0737a; font-size:0.9rem; font-family:Georgia,serif; cursor:pointer; text-decoration:underline; padding:0;" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div style="background:white; border:1px solid #f0c4d0; border-radius:24px; padding:60px; text-align:center;">
      <p style="font-size:4rem; margin:0 0 1rem;">📚</p>
      <h2 style="color:#4a1c35;">No books yet</h2>
      <p style="color:#b07090;">Be the first to add one.</p>
    </div>
  <% end %>
</div>