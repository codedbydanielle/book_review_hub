<% content_for :title, @book.title %>

<% average_rating = @book.reviews.any? ? @book.reviews.average(:rating).to_f.round(1) : 0 %>

<div style="display:grid; grid-template-columns: 340px 1fr; gap:48px; align-items:start;">

  <!-- LEFT SIDE -->
  <div>
    <div style="background:linear-gradient(135deg,#fff0f3,#fde7ef); border:1px solid #f0c4d0; border-radius:26px; height:500px; display:flex; align-items:center; justify-content:center; box-shadow:0 10px 24px rgba(0,0,0,0.04);">
      <div style="width:210px; height:310px; background:white; border-radius:18px; display:flex; align-items:center; justify-content:center; box-shadow:0 12px 24px rgba(0,0,0,0.08); font-size:5rem;">
        📖
      </div>
    </div>

    <div style="margin-top:24px; background:white; border:1px solid #f0c4d0; border-radius:20px; padding:24px;">
      <h3 style="margin-top:0; color:#4a1c35; font-size:1.2rem;">
        About Book
      </h3>

      <div style="display:flex; flex-direction:column; gap:16px; margin-top:18px;">

        <div>
          <p style="margin:0; color:#b07090; font-size:0.8rem; font-weight:700;">
            TITLE
          </p>
          <p style="margin:4px 0 0; color:#4a1c35; font-size:1rem;">
            <%= @book.title %>
          </p>
        </div>

        <div>
          <p style="margin:0; color:#b07090; font-size:0.8rem; font-weight:700;">
            AUTHOR
          </p>
          <p style="margin:4px 0 0; color:#4a1c35; font-size:1rem;">
            <%= @book.author %>
          </p>
        </div>

        <% if @book.genre.present? %>
          <div>
            <p style="margin:0; color:#b07090; font-size:0.8rem; font-weight:700;">
              GENRE
            </p>
            <p style="margin:4px 0 0; color:#4a1c35; font-size:1rem;">
              <%= @book.genre %>
            </p>
          </div>
        <% end %>

        <% if @book.isbn.present? %>
          <div>
            <p style="margin:0; color:#b07090; font-size:0.8rem; font-weight:700;">
              ISBN
            </p>
            <p style="margin:4px 0 0; color:#4a1c35; font-size:1rem;">
              <%= @book.isbn %>
            </p>
          </div>
        <% end %>

      </div>
    </div>
  </div>

  <!-- RIGHT SIDE -->
  <div>

    <% if @book.genre.present? %>
      <span style="background:#fce8ef; color:#c2547a; font-size:0.75rem; font-weight:700; padding:5px 14px; border-radius:999px;">
        <%= @book.genre.upcase %>
      </span>
    <% end %>

    <h1 style="font-size:4rem; line-height:1; margin:18px 0 10px; color:#4a1c35;">
      <%= @book.title %>
    </h1>

    <p style="font-size:1.4rem; color:#b07090; margin-top:0;">
      by <%= @book.author %>
    </p>

    <!-- RATING -->
    <div style="display:flex; align-items:center; gap:12px; margin-top:24px;">

      <div style="font-size:1.5rem; color:#e7a8bc;">
        <% 5.times do |i| %>
          <%= i < average_rating.round ? "★" : "☆" %>
        <% end %>
      </div>

      <span style="font-size:1.2rem; font-weight:700; color:#4a1c35;">
        <%= average_rating %>/5
      </span>

      <span style="color:#b07090;">
        (<%= pluralize(@reviews.count, "review") %>)
      </span>
    </div>

    <!-- ACTION BUTTONS -->
    <% if user_signed_in? && @book.user == current_user %>
      <div style="display:flex; gap:14px; margin-top:28px;">

        <%= link_to "Edit Book", edit_book_path(@book),
          style:"background:#fce8ef; color:#7d3554; border-radius:999px; padding:11px 24px; font-weight:700; text-decoration:none;" %>

        <%= button_to "Delete Book", @book,
          method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          style:"border:1.5px solid #f0c4d0; background:white; color:#c0737a; border-radius:999px; padding:11px 24px; font-family:Georgia,serif; font-weight:700; cursor:pointer;" %>

      </div>
    <% end %>

    <!-- DESCRIPTION -->
    <div style="margin-top:42px; background:white; border:1px solid #f0c4d0; border-radius:24px; padding:32px;">

      <h2 style="margin-top:0; color:#4a1c35; font-size:1.5rem;">
        Summary
      </h2>

      <p style="color:#6b4c5a; line-height:2; font-size:1.02rem;">
        <%= @book.description.presence || "No description added yet." %>
      </p>

    </div>

    <!-- REVIEW FORM -->
    <div style="margin-top:34px; background:white; border:1px solid #f0c4d0; border-radius:24px; padding:32px;">

      <h2 style="margin-top:0; color:#4a1c35;">
        Reader Reviews
      </h2>

      <% if user_signed_in? %>
        <%= render "reviews/form", book: @book, review: @review %>
      <% else %>
        <p style="color:#b07090;">
          <%= link_to "Sign in", new_user_session_path, style:"color:#c2547a; font-weight:700;" %>
          to leave a review.
        </p>
      <% end %>

      <div style="margin-top:32px; display:flex; flex-direction:column; gap:18px;">

        <% @reviews.each do |review| %>
          <div style="background:#fff8fa; border:1px solid #f0d7df; border-radius:18px; padding:20px;">

            <div style="display:flex; justify-content:space-between; align-items:start; gap:20px;">

              <div>
                <div style="color:#e7a8bc; font-size:1rem;">
                  <% 5.times do |i| %>
                    <%= i < review.rating ? "★" : "☆" %>
                  <% end %>
                </div>

                <p style="margin:12px 0; color:#4a1c35; line-height:1.8;">
                  <%= review.content %>
                </p>

                <p style="margin:0; color:#b07090; font-size:0.85rem;">
                  — <%= review.user.email %>
                </p>
              </div>

              <% if user_signed_in? && review.user == current_user %>
                <%= button_to "Delete",
                  book_review_path(@book, review),
                  method: :delete,
                  data: { turbo_confirm: "Delete review?" },
                  style:"background:none; border:none; color:#c0737a; cursor:pointer; text-decoration:underline; font-family:Georgia,serif;" %>
              <% end %>

            </div>
          </div>
        <% end %>

      </div>
    </div>

    <div style="margin-top:24px;">
      <%= link_to "← Back to Books", books_path,
        style:"color:#c2547a; font-weight:700; text-decoration:none;" %>
    </div>

  </div>
</div>