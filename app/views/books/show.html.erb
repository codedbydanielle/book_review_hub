<div class="mt-10 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
  <h2 class="text-2xl font-bold text-gray-900">Reviews</h2>

  <% if user_signed_in? %>
    <%= render "reviews/form", book: @book, review: @review %>
  <% else %>
    <p class="mt-4 text-gray-600">
      Please <%= link_to "sign in", new_user_session_path, class: "text-blue-600 underline" %> to leave a review.
    </p>
  <% end %>

  <div class="mt-8 space-y-4">
    <% @reviews.each do |review| %>
      <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-semibold text-gray-900">
              <%= review.rating %>/5 stars
            </p>

            <p class="mt-2 text-gray-700">
              <%= review.content %>
            </p>

            <p class="mt-2 text-xs text-gray-500">
              Reviewed by <%= review.user.email %>
            </p>
          </div>

          <% if user_signed_in? && review.user == current_user %>
            <%= button_to "Delete",
              book_review_path(@book, review),
              method: :delete,
              data: { turbo_confirm: "Are you sure?" },
              class: "text-sm font-semibold text-red-600 hover:text-red-800" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @reviews.empty? %>
      <p class="text-gray-500">No reviews yet. Be the first to review this book.</p>
    <% end %>
  </div>
</div>