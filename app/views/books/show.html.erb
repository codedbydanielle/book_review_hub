<% content_for :title, @book.title %>

<div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-4xl font-extrabold text-slate-900">
        <%= @book.title %>
      </h1>

      <p class="mt-2 text-lg text-slate-600">
        by <%= @book.author %>
      </p>

      <% if @book.genre.present? %>
        <span class="mt-4 inline-block rounded-full bg-blue-50 px-3 py-1 text-sm font-semibold text-blue-700">
          <%= @book.genre %>
        </span>
      <% end %>
    </div>

    <% if user_signed_in? && @book.user == current_user %>
      <div class="flex gap-3">
        <%= link_to "Edit Book", edit_book_path(@book),
          class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-500" %>

        <%= button_to "Delete Book", @book,
          method: :delete,
          data: { turbo_confirm: "Are you sure you want to delete this book?" },
          class: "rounded-md bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-100" %>
      </div>
    <% end %>
  </div>

  <div class="mt-8 space-y-4">
    <% if @book.isbn.present? %>
      <p class="text-sm text-slate-500">
        <span class="font-semibold text-slate-700">ISBN:</span>
        <%= @book.isbn %>
      </p>
    <% end %>

    <div>
      <h2 class="text-xl font-bold text-slate-900">Description</h2>
      <p class="mt-2 leading-relaxed text-slate-700">
        <%= @book.description.presence || "No description added yet." %>
      </p>
    </div>
  </div>
</div>

<div class="mt-8 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
  <h2 class="text-2xl font-extrabold text-slate-900">Reviews</h2>

  <% if user_signed_in? %>
    <%= render "reviews/form", book: @book, review: @review %>
  <% else %>
    <p class="mt-4 text-slate-600">
      Please <%= link_to "sign in", new_user_session_path, class: "font-semibold text-blue-600 hover:underline" %>
      to leave a review.
    </p>
  <% end %>

  <div class="mt-8 space-y-4">
    <% @reviews.each do |review| %>
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-bold text-slate-900">
              <%= review.rating %>/5 stars
            </p>

            <p class="mt-2 text-slate-700">
              <%= review.content %>
            </p>

            <p class="mt-2 text-xs text-slate-500">
              Reviewed by <%= review.user.email %>
            </p>
          </div>

          <% if user_signed_in? && review.user == current_user %>
            <%= button_to "Delete",
              book_review_path(@book, review),
              method: :delete,
              data: { turbo_confirm: "Are you sure?" },
              class: "text-sm font-semibold text-red-600 hover:text-red-800" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @reviews.empty? %>
      <p class="text-slate-500">No reviews yet. Be the first to review this book.</p>
    <% end %>
  </div>
</div>

<div class="mt-6">
  <%= link_to "Back to Books", books_path,
    class: "font-semibold text-blue-600 hover:underline" %>
</div>