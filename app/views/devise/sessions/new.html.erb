<div style="max-width: 420px; margin: 0 auto;">
  <div style="text-align: center; margin-bottom: 2.2rem;">
    <p style="font-size: 2.7rem; margin: 0;">📖</p>

    <h1 style="
      font-size: 1.9rem;
      font-weight: 700;
      color: #4a1c35;
      margin: 10px 0 6px;
    ">
      Welcome back
    </h1>

    <p style="
      color: #b07090;
      font-size: 0.95rem;
      line-height: 1.6;
      margin: 0;
    ">
      Sign in to continue your reading journey ✨
    </p>
  </div>

  <div style="
    background: white;
    border: 1px solid #f0c4d0;
    border-radius: 24px;
    padding: 2.2rem;
    box-shadow: 0 8px 20px rgba(0,0,0,0.04);
  ">
    <%= form_for(resource,
      as: resource_name,
      url: session_path(resource_name)) do |f| %>

      <div style="margin-bottom: 1.25rem;">
        <%= f.label :email,
          style: "
            display: block;
            font-size: 0.88rem;
            font-weight: 700;
            color: #7d3554;
            margin-bottom: 6px;
          "
        %>

        <%= f.email_field :email,
          autofocus: true,
          autocomplete: "email",
          placeholder: "you@example.com",
          style: "
            width: 100%;
            border: 1.5px solid #f0c4d0;
            border-radius: 12px;
            padding: 11px 14px;
            font-size: 0.95rem;
            font-family: Georgia, serif;
            color: #4a1c35;
            background: #fffafc;
            box-sizing: border-box;
          "
        %>
      </div>

      <div style="margin-bottom: 0.4rem;">
        <%= f.label :password,
          style: "
            display: block;
            font-size: 0.88rem;
            font-weight: 700;
            color: #7d3554;
            margin-bottom: 6px;
          "
        %>

        <%= f.password_field :password,
          autocomplete: "current-password",
          placeholder: "••••••••",
          style: "
            width: 100%;
            border: 1.5px solid #f0c4d0;
            border-radius: 12px;
            padding: 11px 14px;
            font-size: 0.95rem;
            font-family: Georgia, serif;
            color: #4a1c35;
            background: #fffafc;
            box-sizing: border-box;
          "
        %>
      </div>

      <div style="
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
      ">
        <% if devise_mapping.rememberable? %>
          <div style="display: flex; align-items: center; gap: 8px;">
            <%= f.check_box :remember_me %>

            <%= f.label :remember_me,
              style: "
                font-size: 0.88rem;
                color: #7d3554;
              "
            %>
          </div>
        <% end %>

        <% if devise_mapping.recoverable? %>
          <%= link_to "Forgot password?",
            new_password_path(resource_name),
            style: "
              font-size: 0.82rem;
              color: #c2547a;
              text-decoration: none;
              font-weight: 600;
            "
          %>
        <% end %>
      </div>

      <%= f.submit "Sign in",
        style: "
          width: 100%;
          background-color: #c2547a;
          color: white;
          border: none;
          border-radius: 999px;
          padding: 13px;
          font-size: 1rem;
          font-family: Georgia, serif;
          font-weight: 700;
          cursor: pointer;
          box-shadow: 0 4px 10px rgba(194,84,122,0.18);
        "
      %>
    <% end %>
  </div>

  <div style="
    text-align: center;
    margin-top: 1.5rem;
    font-size: 0.88rem;
    color: #b07090;
    line-height: 1.6;
  ">
    <p style="margin-bottom: 10px;">
      New here? Join our cozy reading community ✨
    </p>

    <%= render "devise/shared/links" %>
  </div>
</div>