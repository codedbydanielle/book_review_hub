<% content_for :title, "My Reviews" %>

<div>
  <h1 style="font-size:3rem; color:#4a1c35; margin-bottom:10px;">
    My Reviews
  </h1>

  <p style="color:#b07090; margin-bottom:32px;">
    Your thoughts, ratings, and reactions ✨
  </p>

  <% if @reviews.any? %>

    <div style="display:flex; flex-direction:column; gap:24px;">

      <% @reviews.each do |review| %>

        <div style="background:white; border:1px solid #f0c4d0; border-radius:24px; padding:28px;">

          <div style="display:flex; justify-content:space-between; align-items:start; gap:20px;">

            <div>

              <p style="margin:0; color:#b07090; font-size:0.9rem;">
                Review for
              </p>

              <h2 style="margin:8px 0; color:#4a1c35; font-size:2rem;">
                <%= link_to review.book.title, review.book,
                  style:"text-decoration:none; color:#4a1c35;" %>
              </h2>

              <p style="color:#b07090; margin-top:0;">
                by <%= review.book.author %>
              </p>

              <div style="margin:16px 0; color:#e7a8bc; font-size:1.2rem;">
                <% 5.times do |i| %>
                  <%= i < review.rating ? "★" : "☆" %>
                <% end %>
              </div>

              <p style="color:#4a1c35; line-height:1.9;">
                <%= review.content %>
              </p>

            </div>

            <%= button_to "Delete",
              book_review_path(review.book, review),
              method: :delete,
              data: { turbo_confirm: "Delete review?" },
              style:"background:none; border:none; color:#c0737a; text-decoration:underline; cursor:pointer; font-family:Georgia,serif;" %>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <div style="background:white; border:1px solid #f0c4d0; border-radius:24px; padding:60px; text-align:center;">

      <p style="font-size:4rem;">💭</p>

      <h2 style="color:#4a1c35;">
        No reviews yet
      </h2>

      <p style="color:#b07090;">
        Start reviewing books you've read.
      </p>

    </div>

  <% end %>
</div>